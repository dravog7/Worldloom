{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window (Worldloom M1). fs scope is intentionally broad for the scaffold and will be narrowed to the chosen vault folder in Wave B3.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "store:default",
    "fs:default",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-rename",
    "fs:allow-remove",
    "fs:allow-watch",
    "fs:allow-unwatch",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$HOME/**" }],
      "deny": [
        { "path": "$HOME/.git/**" },
        { "path": "$HOME/node_modules/**" }
      ]
    }
  ]
}
